# Copy to .env and fill in. NEVER commit a real .env.
# Gemini (Tier 1)
GEMINI_API_KEY=
# Groq (Tier 2)
GROQ_API_KEY=
# DeepSeek (Tier 3, OpenAI-compatible base https://api.deepseek.com)
DEEPSEEK_API_KEY=
# GitHub (optional — raises unauthenticated 60 req/hr limit to 5,000/hr)
GITHUB_TOKEN=
# arXiv / Papers With Code / RSS need no key.
